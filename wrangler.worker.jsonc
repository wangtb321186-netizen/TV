{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "decotv",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-23",
  "compatibility_flags": ["nodejs_compat"],
  // Configure this binding in the Workers/Pages dashboard for each environment.
  // Do not add a placeholder namespace ID here; the dashboard binding is used by Pages.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
}
